  "cards": [
    {
      "dot": "cyan",
      "title": "Run lifecycle",
      "items": [
        "POST /runs starts AgentRunWorkflow (workflow id = run_id) and returns 202",
        "Status query: queued → running_agent → publishing → completed / failed",
        "Failed runs still publish RUN_FINISHED with status failed, then the workflow fails"
      ]
    },
    {
      "dot": "emerald",
      "title": "Delivery guarantees",
      "items": [
        "Producer: acks=all, idempotent; publish retries until Kafka accepts",
        "Consumers commit only after success or DLQ: at-least-once, replay-safe",
        "Persistence upserts on run_id; notifications claim event_id before sending"
      ]
    },
    {
      "dot": "amber",
      "title": "Runtime and what's next",
      "items": [
        "Docker Compose: Temporal, Postgres (one instance, two logical stores), Kafka, Redis",
        "Host via Tilt: API, worker, both consumers; CLI and Streamlit call the agent directly",
        "Phase 5: login API fills user_id · Phase 6: Redis token-bucket rate limiting"
      ]
    }
  ]
