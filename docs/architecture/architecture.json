  "cards": [
    {
      "dot": "cyan",
      "title": "Run lifecycle",
      "items": [
        "POST /runs needs a Bearer JWT; starts AgentRunWorkflow with user_id in input + memo, returns 202",
        "Status query: queued → running_agent → publishing → completed / failed",
        "GET /runs/{id} is 404 unless the memo user_id is the caller; GET /runs lists your rows from Postgres"
      ]
    },
    {
      "dot": "emerald",
      "title": "Delivery guarantees",
      "items": [
        "Producer: acks=all, idempotent; publish retries until Kafka accepts",
        "Consumers commit only after success or DLQ: at-least-once, replay-safe",
        "Persistence upserts on run_id; notifications claim event_id before sending"
      ]
    },
    {
      "dot": "amber",
      "title": "Runtime and what's next",
      "items": [
        "Docker Compose: Temporal, Postgres (one instance, two logical stores), Kafka, Redis, webhook-tester",
        "Host via Tilt: Login + Run API (two routers, one FastAPI process :8000), worker, both consumers",
        "Phase 6: Redis token-bucket rate limiting in front of /auth and /runs"
      ]
    }
  ]
