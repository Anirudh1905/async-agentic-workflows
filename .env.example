# OpenAI-compatible LLM endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
AGENT_MAX_STEPS=10

# Docker Compose (host ports; defaults avoid common local clashes)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433
APP_DB=agentic
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
KAFKA_PORT=9092
KAFKA_UI_PORT=8081
REDIS_PORT=6380

# Connection URLs for the app (used from phase 3 on)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/agentic
TEMPORAL_ADDRESS=127.0.0.1:7233
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
REDIS_URL=redis://127.0.0.1:6380/0
