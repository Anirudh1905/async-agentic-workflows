# Logging for every process: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# OpenAI-compatible LLM endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
AGENT_MAX_STEPS=10

# Docker Compose (host ports; defaults avoid common local clashes)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433
APP_DB=agentic
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
KAFKA_PORT=9092
KAFKA_UI_PORT=8081
REDIS_PORT=6380

# Connection URLs for the app (used from phase 3 on)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/agentic
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agent-runs
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
RUN_FINISHED_TOPIC=RUN_FINISHED
RUN_FINISHED_DLQ_TOPIC=RUN_FINISHED.DLQ
REDIS_URL=redis://127.0.0.1:6380/0

# Optional: POST every RUN_FINISHED event here (notification consumer). Unset = log only.
# Default points at the local webhook-tester inbox (UI: http://127.0.0.1:8082/s/<same uuid>).
NOTIFY_WEBHOOK_URL=http://127.0.0.1:8082/a9e7c0de-0000-4000-8000-000000000001
WEBHOOK_TESTER_PORT=8082

# Login API (phase 5). Signs access tokens; at least 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=
JWT_TTL_MINUTES=30
